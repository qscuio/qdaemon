#
# QDaemon DHCP Server Makefile (Industrial Grade)
#

# --- Configuration ---
STANDALONE   ?= 0
QDAEMON_ROOT ?= ../..
DEBUG        ?= 0
DESTDIR      ?=

# --- Toolchain ---
CC      ?= gcc
INSTALL ?= install

# --- Flags ---
CFLAGS  := -Wall -Wextra -std=gnu11 -D_GNU_SOURCE
CFLAGS  += -Iinclude -MMD -MP

# Linker flags
LDFLAGS := 

ifeq ($(STANDALONE),1)
    CFLAGS  += -DSTANDALONE
    LIBS    := -lpthread -lrt -lreadline
else
    CFLAGS  += -I$(QDAEMON_ROOT)/include -I$(QDAEMON_ROOT)/src/util
    LDFLAGS += -L$(QDAEMON_ROOT)/lib
    LIBS    := -lqdaemon -lpthread -lrt -lreadline
endif

# Build Profile
ifeq ($(DEBUG),1)
    CFLAGS += -g -O0 -DDEBUG
else
    CFLAGS += -O2 -DNDEBUG -fstack-protector-strong -D_FORTIFY_SOURCE=2
endif

# --- Sources ---
# Recursively find all source files in src/
# Exclude test files or stubs if not needed
SRCS_CORE := $(wildcard src/*.c)

ifeq ($(STANDALONE),0)
    # Filter out stub in normal mode
    SRCS_CORE := $(filter-out src/qdaemon_stub.c, $(SRCS_CORE))
endif

OBJS_CORE := $(SRCS_CORE:.c=.o)
DEPS_CORE := $(OBJS_CORE:.o=.d)

# CLI Sources
SRCS_CLI := $(wildcard cli/*.c)
OBJS_CLI := $(SRCS_CLI:.c=.o)
DEPS_CLI := $(OBJS_CLI:.o=.d)

# Targets
TARGET_SERVER := qd_dhcpd
TARGET_CLI    := qd_dhcp_cli

# --- Rules ---
.PHONY: all clean install kmods

all: $(TARGET_SERVER) $(TARGET_CLI)

$(TARGET_SERVER): $(OBJS_CORE)
	@echo "  LD      $@"
	@$(CC) -o $@ $^ $(LDFLAGS) $(LIBS)

$(TARGET_CLI): $(OBJS_CLI)
	@echo "  LD      $@"
	@$(CC) -o $@ $^ $(LDFLAGS) $(LIBS)

# Generic Compilation Rule
%.o: %.c
	@echo "  CC      $<"
	@$(CC) $(CFLAGS) -c -o $@ $<

# Include dependency files (generated by -MMD)
-include $(DEPS_CORE)
-include $(DEPS_CLI)

# --- Clean ---
clean:
	@echo "  CLEAN"
	@rm -f $(TARGET_SERVER) $(TARGET_CLI)
	@rm -f src/*.o src/*.d cli/*.o cli/*.d

# --- Kernel Modules ---
kmods:
	$(MAKE) -C kernel

kmods-clean:
	$(MAKE) -C kernel clean

# --- Installation ---
install: all
	$(INSTALL) -d $(DESTDIR)/usr/sbin $(DESTDIR)/usr/bin
	$(INSTALL) -m 755 $(TARGET_SERVER) $(DESTDIR)/usr/sbin/
	$(INSTALL) -m 755 $(TARGET_CLI)    $(DESTDIR)/usr/bin/
	$(INSTALL) -d $(DESTDIR)/etc/qd-dhcpd
	$(INSTALL) -m 644 etc/qd-dhcpd/qd-dhcpd.conf $(DESTDIR)/etc/qd-dhcpd/
